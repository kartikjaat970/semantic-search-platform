# Copy to .env and change the password. Keep it to letters and digits;
# special characters would need URL-encoding in the connection string.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb

# Only needed when running the backend outside Docker.
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/ragdb
# CORS_ORIGINS=http://localhost:3000
